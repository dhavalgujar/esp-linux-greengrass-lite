From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dhaval Gujar <dhaval.gujar@espressif.com>
Date: Sun, 8 Nov 2026 20:35:53 +0530
Subject: [PATCH 9/9] ggl-svc: wait for ggl-svcd as long as systemctl waits for
 systemd

ggl-svc's systemctl gave up after 10 s. ggl-svcd serves one request at a
time, so a call can wait for others first, and on a busy board a
deployment's "systemctl daemon-reload" failed after 12 s with "cannot
reach ggl-svcd". systemctl waits 25 s for systemd over D-Bus, or what
$SYSTEMD_BUS_TIMEOUT says; ggl-svc's client now does the same (seconds,
or a number with a unit, or "infinity"; unset or 0 for the default).
Upstream: not yet submitted (developed on the esp32s31/v2.7.0 branch of a fork)
---
 modules/ggl-svc/src/client.c | 69 +++++++++++++++++++++++++++++++++---
 1 file changed, 64 insertions(+), 5 deletions(-)

diff --git a/modules/ggl-svc/src/client.c b/modules/ggl-svc/src/client.c
index a04854c..ba01b79 100644
--- a/modules/ggl-svc/src/client.c
+++ b/modules/ggl-svc/src/client.c
@@ -4,16 +4,70 @@
 
 #include <errno.h>
 #include <ggl/svc.h>
+#include <stdint.h>
+#include <stdlib.h>
 #include <string.h>
 #include <sys/socket.h>
 #include <sys/time.h>
 #include <sys/un.h>
 #include <unistd.h>
 
-// ggl-svcd answers every request at once; a call that waits longer than
-// this is not going to be answered (it serves one request per connection
-// and drops connections that stall), so callers fail instead of hanging.
-#define CALL_TIMEOUT_S 10
+// How long a call waits for ggl-svcd, which serves one request at a time:
+// systemctl's D-Bus default, also overridden by $SYSTEMD_BUS_TIMEOUT
+// (seconds, or a number with a unit: us, ms, s, min, h; "infinity"; unset or
+// 0 for the default). Callers fail instead of hanging on a stalled daemon.
+#define CALL_TIMEOUT_DEFAULT_US (25ULL * 1000000ULL)
+
+static uint64_t call_timeout_us(void) {
+    const char *value = getenv("SYSTEMD_BUS_TIMEOUT");
+    if ((value == NULL) || (*value == '\0')) {
+        return CALL_TIMEOUT_DEFAULT_US;
+    }
+    if (strcmp(value, "infinity") == 0) {
+        return 0;
+    }
+    char *end;
+    errno = 0;
+    double number = strtod(value, &end);
+    if ((errno != 0) || (end == value) || !(number >= 0)) {
+        return CALL_TIMEOUT_DEFAULT_US;
+    }
+    while (*end == ' ') {
+        end++;
+    }
+    static const struct {
+        const char *unit;
+        double us;
+    } UNITS[] = {
+        { "", 1e6 },
+        { "s", 1e6 },
+        { "sec", 1e6 },
+        { "second", 1e6 },
+        { "seconds", 1e6 },
+        { "us", 1 },
+        { "usec", 1 },
+        { "ms", 1e3 },
+        { "msec", 1e3 },
+        { "m", 60e6 },
+        { "min", 60e6 },
+        { "minute", 60e6 },
+        { "minutes", 60e6 },
+        { "h", 3600e6 },
+        { "hr", 3600e6 },
+        { "hour", 3600e6 },
+        { "hours", 3600e6 },
+    };
+    for (size_t i = 0; i < sizeof(UNITS) / sizeof(UNITS[0]); i++) {
+        if (strcmp(end, UNITS[i].unit) == 0) {
+            double us = number * UNITS[i].us;
+            if ((us < 1) || (us >= 1e15)) {
+                return CALL_TIMEOUT_DEFAULT_US;
+            }
+            return (uint64_t) us;
+        }
+    }
+    return CALL_TIMEOUT_DEFAULT_US;
+}
 
 int ggl_svc_connect(void) {
     int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
@@ -71,7 +125,12 @@ int ggl_svc_call(const char *request, char *resp, size_t resp_len) {
     if (fd < 0) {
         return -1;
     }
-    struct timeval timeout = { .tv_sec = CALL_TIMEOUT_S };
+    // A zero timeval waits without limit ("infinity").
+    uint64_t timeout_us = call_timeout_us();
+    struct timeval timeout = {
+        .tv_sec = (time_t) (timeout_us / 1000000U),
+        .tv_usec = (suseconds_t) (timeout_us % 1000000U),
+    };
     (void) setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
     (void) setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
     char line[1024];
