# Development profile: the kernel brings eth0 up with DHCP and mounts its
# root over NFSv3. scripts/build.sh writes the matching CONFIG_CMDLINE
# (server address and export path) into the output directory.
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_CMDLINE_FORCE=y
