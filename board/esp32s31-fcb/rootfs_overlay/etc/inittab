# ESP32-S31 portable Greengrass image: busybox init on a writable NFS root.
# The kernel has already configured eth0 by DHCP (ip=dhcp) to mount the
# root, so nothing here may run a userspace DHCP client on eth0: a
# deconfigure would pull the root filesystem out from under the system.
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/ln -sfn /proc/self/fd /dev/fd
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS
console::respawn:/sbin/getty -n -l /bin/sh 115200 ttyS0 vt100
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
