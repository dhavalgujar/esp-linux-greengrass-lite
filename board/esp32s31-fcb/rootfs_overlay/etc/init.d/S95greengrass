#!/bin/sh
# SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
# SPDX-License-Identifier: Apache-2.0
#
# Greengrass Lite without systemd: ggl-svcd runs the core daemons (units in
# /usr/lib/ggl-svc) and every component unit a deployment linked and
# enabled, and answers the systemctl calls ggdeploymentd makes. All output
# goes to syslog: grep <unit> /var/log/messages.
#
# Device state lives in /var/lib: /var/lib/greengrass (credentials,
# configuration database, deployed components; Greengrass's rootPath) and
# /var/lib/ggl-svc (linked and enabled units). A board with persistent
# storage mounts it on /var/lib (/etc/fstab); without it, /var/lib is a RAM
# file system and the device starts fresh at every boot.
#
# The device's identity, in order:
#   1. a connection kit dropped on the storage, in
#      /var/lib/greengrass/connection-kit: applied, then removed;
#   2. the connection kit in the image, /etc/greengrass/connection-kit,
#      unless it is the one last applied;
#   3. the identity already in /var/lib/greengrass;
#   4. a claim certificate in /etc/greengrass/claim: AWS IoT fleet
#      provisioning (in the background);
#   otherwise Greengrass is not started.
# A connection kit is what the AWS IoT console's "Set up one core device"
# downloads for nucleus lite (device.pem.crt, private.pem.key,
# AmazonRootCA1.pem, config.yaml); applying it puts the credentials in
# /var/lib/greengrass/credentials and its configuration in
# /var/lib/greengrass/config.d (/etc/greengrass/config.d links there). A kit
# for another device than the current one starts the device over: its
# Greengrass state is removed first.
#
# /etc/default/greengrass may set:
#   GGL_STATE_TMPFS_SIZE  size of the RAM /var/lib (default 4m)
#   GGL_SERIAL            the device's serial number for fleet provisioning
#                         (default: eth0's MAC address, hex digits)

GG_CONF=/etc/greengrass
GG_ROOT=/var/lib/greengrass
CLAIM=$GG_CONF/claim
CREDS=$GG_ROOT/credentials
APPLIED=$GG_ROOT/connection-kit.applied
PIDFILE=/run/ggl-svcd.pid
PROV_PIDFILE=/run/ggl-provision.pid
GGL_STATE_TMPFS_SIZE=4m
GGL_SERIAL=
[ -r /etc/default/greengrass ] && . /etc/default/greengrass

log() { logger -t greengrass "$*"; }

running() {
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = ggl-svcd ]
}

setup_state() {
	if ! mountpoint -q /var/lib; then
		mount -t tmpfs -o "mode=0755,size=$GGL_STATE_TMPFS_SIZE" tmpfs \
			/var/lib || return 1
	fi
	[ -e /var/lib/misc ] || ln -s ../../tmp /var/lib/misc
	install -d -o ggcore -g ggcore -m 0755 "$GG_ROOT" "$GG_ROOT/config.d"
	# ggl-svcd refuses a state directory anyone but root can write.
	install -d -o root -g root -m 0700 /var/lib/ggl-svc
}

provisioned() {
	# A connection kit or a manual setup has device.pem.crt;
	# fleet-provisioning writes certificate.pem.
	[ -s "$CREDS/device.pem.crt" ] || [ -s "$CREDS/certificate.pem" ]
}

kit_fingerprint() {
	cat "$1/config.yaml" "$1/device.pem.crt" "$1/private.pem.key" \
		"$1/AmazonRootCA1.pem" 2>/dev/null | sha256sum | cut -d' ' -f1
}

# Runs as ggcore, which owns everything it writes (and so cannot be made to
# copy what it could not read itself).
apply_kit() {
	kit=$1
	for f in config.yaml device.pem.crt private.pem.key AmazonRootCA1.pem; do
		if [ ! -s "$kit/$f" ]; then
			echo "connection kit $kit: $f missing" >&2
			return 1
		fi
	done
	umask 077
	mkdir -p "$CREDS" "$GG_ROOT/config.d"
	for f in device.pem.crt private.pem.key AmazonRootCA1.pem; do
		cat "$kit/$f" >"$CREDS/$f.new" && mv "$CREDS/$f.new" "$CREDS/$f" ||
			return 1
	done
	# The console's kit leaves its directory and the nucleus component's
	# name to be filled in.
	sed -e "s|{{config_dir}}|$CREDS|g" \
		-e 's|{{nucleus_component}}|aws.greengrass.NucleusLite|g' \
		"$kit/config.yaml" >"$GG_ROOT/config.d/connection-kit.yaml.new" &&
		chmod 0644 "$GG_ROOT/config.d/connection-kit.yaml.new" &&
		mv "$GG_ROOT/config.d/connection-kit.yaml.new" \
			"$GG_ROOT/config.d/connection-kit.yaml" || return 1
	kit_fingerprint "$kit" >"$APPLIED"
}

# A new identity is a new device: nothing of the previous one's state
# (configuration, deployments, units) carries over. A kit dropped on the
# storage is kept until it has been applied.
reset_state() {
	find "$GG_ROOT" -mindepth 1 -maxdepth 1 ! -name connection-kit \
		-exec rm -rf {} +
	find /var/lib/ggl-svc -mindepth 1 -maxdepth 1 -exec rm -rf {} +
	install -d -o ggcore -g ggcore -m 0755 "$GG_ROOT/config.d"
}

use_kit() {
	if provisioned; then
		log "new connection kit $1: starting the device over"
		reset_state
	fi
	if su -s /bin/sh ggcore -c "'$0' apply-kit '$1'"; then
		log "connection kit $1 applied"
	else
		log "connection kit $1 could not be applied"
	fi
}

start_svcd() {
	# The core daemons run as ggcore and create their sockets here.
	install -d -o ggcore -g ggcore -m 0755 /run/greengrass
	# ggl-svcd and every unit log to syslog (/var/log/messages).
	/usr/bin/ggl-svcd </dev/null >/dev/null 2>&1 &
	echo $! >"$PIDFILE"
}

stop_svcd() {
	# ggl-svcd stops every unit before it exits. Match the process by name:
	# its executable path no longer matches once the file was replaced.
	if running; then
		kill "$pid"
		tries=150
		while [ -d "/proc/$pid" ] && [ "$tries" -gt 0 ]; do
			usleep 100000
			tries=$((tries - 1))
		done
	fi
	rm -f "$PIDFILE"
}

# Fleet provisioning, as upstream documents it: with the core daemons
# running (it reads and writes their configuration), fleet-provisioning
# connects with the claim certificate, has AWS IoT sign a certificate for a
# key generated here and register the Thing, and stores both in $CREDS.
# The daemons are then restarted with the device's identity.
provision() {
	serial=${GGL_SERIAL:-$(tr -d ':\n' </sys/class/net/eth0/address)}
	attempt=1
	while :; do
		# A socket left by the previous attempt must not count as ready.
		rm -f /run/greengrass/gg_config
		start_svcd
		tries=600
		while [ ! -S /run/greengrass/gg_config ] && [ "$tries" -gt 0 ]; do
			usleep 200000
			tries=$((tries - 1))
		done
		rm -f /run/greengrass/iotcoredfleet
		logger -t ggl-provision "provisioning serial $serial (attempt $attempt)"
		# Its options take attached values only (--option=value).
		timeout 180 /usr/bin/fleet-provisioning \
			--template-params="{\"SerialNumber\":\"$serial\"}" 2>&1 |
			logger -t ggl-provision
		stop_svcd
		if provisioned; then
			logger -t ggl-provision "provisioned"
			start_svcd
			return 0
		fi
		if [ "$attempt" -ge 3 ]; then
			logger -t ggl-provision "provisioning failed; Greengrass not started"
			return 1
		fi
		attempt=$((attempt + 1))
		sleep 30
	done
}

case "$1" in
start)
	if [ ! -f "$GG_CONF/config.yaml" ]; then
		echo "Greengrass: $GG_CONF/config.yaml missing, not starting" >&2
		exit 0
	fi
	if running; then
		echo "Greengrass Lite already running (ggl-svcd $pid)"
		exit 0
	fi
	printf 'Starting Greengrass Lite: '
	if ! setup_state; then
		echo "FAIL (cannot set up /var/lib)"
		exit 1
	fi
	if [ -d "$GG_ROOT/connection-kit" ]; then
		use_kit "$GG_ROOT/connection-kit"
		rm -rf "$GG_ROOT/connection-kit"
	elif [ -d "$GG_CONF/connection-kit" ] &&
		[ "$(kit_fingerprint "$GG_CONF/connection-kit")" != "$(cat "$APPLIED" 2>/dev/null)" ]; then
		use_kit "$GG_CONF/connection-kit"
	fi
	if provisioned; then
		start_svcd
		echo "OK"
	elif [ -s "$CLAIM/claim.pem.crt" ]; then
		provision </dev/null >/dev/null 2>&1 &
		echo $! >"$PROV_PIDFILE"
		echo "OK (provisioning in the background)"
	else
		echo "no identity (no connection kit, credentials or claim)"
	fi
	;;
apply-kit)
	# Internal: applying a connection kit, as ggcore (see use_kit).
	apply_kit "$2"
	;;
stop)
	printf 'Stopping Greengrass Lite: '
	# A provisioning run in progress would start ggl-svcd again.
	prov=$(cat "$PROV_PIDFILE" 2>/dev/null)
	if [ -n "$prov" ] && kill -0 "$prov" 2>/dev/null; then
		kill "$prov"
		# fleet-provisioning stops its own MQTT client only when it exits
		# normally.
		pkill -f /usr/bin/fleet-provisioning
		pkill -f 'iotcored -n iotcoredfleet'
	fi
	rm -f "$PROV_PIDFILE"
	stop_svcd
	echo "OK"
	;;
restart)
	"$0" stop
	"$0" start
	;;
status)
	for unit in /usr/lib/ggl-svc/*.service /var/lib/ggl-svc/links/*; do
		[ -e "$unit" ] || continue
		systemctl show "${unit##*/}"
	done
	;;
*)
	echo "usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
