#!/bin/sh
#
# AWS IoT rejects TLS from a clock that still reads 1970, so try to set the
# time before Greengrass starts, then keep it in sync. Each attempt asks all
# servers at once (one unresponsive server costs busybox ntpd ~10 s), and
# the wait is bounded: if no server answers, boot continues, the daemon
# keeps trying, and iotcored reconnects once the clock is right.

NTP_SERVERS=${NTP_SERVERS:-"pool.ntp.org time.google.com"}
NTP_TRIES=${NTP_TRIES:-3}

peers=
for server in $NTP_SERVERS; do
	peers="$peers -p $server"
done

case "$1" in
start)
	printf 'Setting clock: '
	tries=0
	until ntpd -n -q $peers >/dev/null 2>&1; do
		tries=$((tries + 1))
		if [ "$tries" -ge "$NTP_TRIES" ]; then
			echo "no answer yet, continuing"
			break
		fi
		sleep 1
	done
	[ "$tries" -lt "$NTP_TRIES" ] && date -u '+%Y-%m-%dT%H:%M:%SZ'
	start-stop-daemon -S -q -b -m -p /run/ntpd.pid -x /usr/sbin/ntpd -- \
		-n $peers
	;;
stop)
	start-stop-daemon -K -q -p /run/ntpd.pid
	;;
restart)
	"$0" stop
	"$0" start
	;;
*)
	echo "usage: $0 {start|stop|restart}" >&2
	exit 1
	;;
esac
