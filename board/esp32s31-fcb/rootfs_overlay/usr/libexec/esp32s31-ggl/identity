#!/bin/sh
# SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
# SPDX-License-Identifier: Apache-2.0
#
# The device's state and identity, set up before Greengrass Lite starts
# (esp32s31-ggl-identity.service).
#
# Device state lives in /var/lib/greengrass: credentials, the configuration
# database and deployed components (Greengrass's rootPath). A board with
# persistent storage mounts it on /var/lib (/etc/fstab); without it, /var/lib
# is a RAM file system and the device starts fresh at every boot.
#
# The device's identity, in order:
#   1. a connection kit dropped on the storage, in
#      /var/lib/greengrass/connection-kit: applied, then removed;
#   2. the connection kit in the image, /etc/greengrass/connection-kit,
#      unless it is the one last applied;
#   3. the identity already in /var/lib/greengrass.
# A connection kit is what the AWS IoT console's "Set up one core device"
# downloads for nucleus lite (device.pem.crt, private.pem.key,
# AmazonRootCA1.pem, config.yaml); applying it puts the credentials in
# /var/lib/greengrass/credentials and its configuration in
# /var/lib/greengrass/config.d (/etc/greengrass/config.d links there). A kit
# for another device than the current one starts the device over: its
# Greengrass state, and the units its deployments linked, are removed first.
#
# /etc/default/greengrass may set:
#   GGL_STATE_TMPFS_SIZE  size of the RAM /var/lib (default 4m)

GG_CONF=/etc/greengrass
GG_ROOT=/var/lib/greengrass
CREDS=$GG_ROOT/credentials
APPLIED=$GG_ROOT/connection-kit.applied
GGL_STATE_TMPFS_SIZE=4m
[ -r /etc/default/greengrass ] && . /etc/default/greengrass

setup_state() {
	if ! mountpoint -q /var/lib; then
		mount -t tmpfs -o "mode=0755,size=$GGL_STATE_TMPFS_SIZE" tmpfs \
			/var/lib || return 1
		# What systemd-tmpfiles created there is now hidden.
		systemd-tmpfiles --create --prefix=/var/lib
	fi
	install -d -o ggcore -g ggcore -m 0755 "$GG_ROOT" "$GG_ROOT/config.d"
}

provisioned() {
	[ -s "$CREDS/device.pem.crt" ] || [ -s "$CREDS/certificate.pem" ]
}

kit_fingerprint() {
	cat "$1/config.yaml" "$1/device.pem.crt" "$1/private.pem.key" \
		"$1/AmazonRootCA1.pem" 2>/dev/null | sha256sum | cut -d' ' -f1
}

# Runs as ggcore, which owns everything it writes (and so cannot be made to
# copy what it could not read itself).
apply_kit() {
	kit=$1
	for f in config.yaml device.pem.crt private.pem.key AmazonRootCA1.pem; do
		if [ ! -s "$kit/$f" ]; then
			echo "connection kit $kit: $f missing" >&2
			return 1
		fi
	done
	umask 077
	mkdir -p "$CREDS" "$GG_ROOT/config.d"
	for f in device.pem.crt private.pem.key AmazonRootCA1.pem; do
		cat "$kit/$f" >"$CREDS/$f.new" && mv "$CREDS/$f.new" "$CREDS/$f" ||
			return 1
	done
	# The console's kit leaves its directory and the nucleus component's
	# name to be filled in.
	sed -e "s|{{config_dir}}|$CREDS|g" \
		-e 's|{{nucleus_component}}|aws.greengrass.NucleusLite|g' \
		"$kit/config.yaml" >"$GG_ROOT/config.d/connection-kit.yaml.new" &&
		chmod 0644 "$GG_ROOT/config.d/connection-kit.yaml.new" &&
		mv "$GG_ROOT/config.d/connection-kit.yaml.new" \
			"$GG_ROOT/config.d/connection-kit.yaml" || return 1
	kit_fingerprint "$kit" >"$APPLIED"
}

# A new identity is a new device: nothing of the previous one's state
# (configuration, deployments, the units they linked) carries over. A kit
# dropped on the storage is kept until it has been applied.
reset_state() {
	for link in /etc/systemd/system/ggl.* \
		/etc/systemd/system/*.wants/ggl.*; do
		case $(readlink "$link") in
		"$GG_ROOT"/*) rm -f "$link" ;;
		esac
	done
	find "$GG_ROOT" -mindepth 1 -maxdepth 1 ! -name connection-kit \
		-exec rm -rf {} +
	install -d -o ggcore -g ggcore -m 0755 "$GG_ROOT/config.d"
}

use_kit() {
	if provisioned; then
		echo "new connection kit $1: starting the device over"
		reset_state
	fi
	if su -s /bin/sh ggcore -c "'$0' apply-kit '$1'"; then
		echo "connection kit $1 applied"
	else
		echo "connection kit $1 could not be applied"
	fi
}

case "$1" in
start)
	[ -f "$GG_CONF/config.yaml" ] || exit 0
	setup_state || exit 1
	if [ -d "$GG_ROOT/connection-kit" ]; then
		use_kit "$GG_ROOT/connection-kit"
		rm -rf "$GG_ROOT/connection-kit"
	elif [ -d "$GG_CONF/connection-kit" ] &&
		[ "$(kit_fingerprint "$GG_CONF/connection-kit")" != "$(cat "$APPLIED" 2>/dev/null)" ]; then
		use_kit "$GG_CONF/connection-kit"
	fi
	provisioned || echo "no identity (no connection kit or credentials)"
	# Deployments link their components' units from /var/lib/greengrass,
	# which may only now be mounted: systemd loaded them at boot as not
	# found. Load them, and start what greengrass-lite.target wants now.
	# A reload keeps systemd busy for half a minute on this board: only
	# when there is something to load.
	for link in /etc/systemd/system/ggl.*; do
		case $(readlink "$link") in
		"$GG_ROOT"/*)
			systemctl daemon-reload
			systemctl --no-block start greengrass-lite.target
			break
			;;
		esac
	done
	;;
apply-kit)
	# Internal: applying a connection kit, as ggcore (see use_kit).
	apply_kit "$2"
	;;
*)
	echo "usage: $0 start" >&2
	exit 1
	;;
esac
