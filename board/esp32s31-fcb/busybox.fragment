CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# CONFIG_FEATURE_NTPD_CONF is not set
# Greengrass log lines (forwarded by ggl-svcd) are longer than the default.
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=512
