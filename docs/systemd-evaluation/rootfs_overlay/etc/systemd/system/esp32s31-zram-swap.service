[Unit]
Description=Compressed swap in RAM (zram)
DefaultDependencies=no
Before=swap.target sysinit.target
ConditionPathExists=/sys/block/zram0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo lzo-rle >/sys/block/zram0/comp_algorithm; echo 8M >/sys/block/zram0/disksize; mkswap /dev/zram0 && swapon -p 100 /dev/zram0'

[Install]
WantedBy=sysinit.target
