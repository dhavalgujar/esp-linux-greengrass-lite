From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dhaval Gujar <dhaval.gujar@espressif.com>
Date: Fri, 30 Oct 2026 01:37:59 +0530
Subject: [PATCH] Retry the fleet provisioning certificate request until
 connected

fleet-provisioning starts iotcored, waits 5 seconds and then sends the
certificate signing request. On a slow device (an ESP32-S31 at 320 MHz
needs about 11 seconds for the TLS connection to AWS IoT Core) iotcored
is not connected yet: the request fails with MQTTStatusNotConnected and
provisioning fails every time.

Retry the certificate request, up to 12 times 5 seconds apart. Until it
succeeds it changes nothing in the cloud. RegisterThing, which follows
once the connection has proven itself, is not retried.

Signed-off-by: Dhaval Gujar <dhaval.gujar@espressif.com>
Upstream: not yet submitted; also present on upstream main (8552acf)
---
 .../fleet-provisioning/src/cloud_request.c    | 32 +++++++++++++++++--
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/modules/fleet-provisioning/src/cloud_request.c b/modules/fleet-provisioning/src/cloud_request.c
index be55e88..5bb4546 100644
--- a/modules/fleet-provisioning/src/cloud_request.c
+++ b/modules/fleet-provisioning/src/cloud_request.c
@@ -7,11 +7,15 @@
 #include <gg/log.h>
 #include <gg/map.h>
 #include <gg/object.h>
+#include <gg/utils.h>
 #include <gg/vector.h>
 #include <ggl/aws_iot_call.h>
 #include <stdbool.h>
 #include <stdint.h>
 
+#define CSR_REQUEST_ATTEMPTS 12
+#define CSR_REQUEST_RETRY_S 5
+
 #define MAX_TOKEN_SIZE 512
 #define MAX_TOPIC_LEN 256
 #define MAX_REQUEST_RESPONSE_SIZE 4096
@@ -191,9 +195,31 @@ GgError ggl_get_certificate_from_aws(
     static uint8_t token_mem[MAX_TOKEN_SIZE];
     GgBuffer token = GG_BUF(token_mem);
     GgBuffer iotcored = GG_STR("iotcoredfleet");
-
-    GgError ret
-        = send_csr_request(csr_as_ggl_buffer, &token, iotcored, cert_pem_out);
+    GgBuffer cert_pem_mem = *cert_pem_out;
+
+    // The caller waits a fixed time for iotcored to connect, which is not
+    // always enough (TLS on a slow core takes longer). Until it succeeds,
+    // the certificate request changes nothing in the cloud, so retry it
+    // while the connection comes up.
+    GgError ret = GG_ERR_FAILURE;
+    for (int attempt = 1; attempt <= CSR_REQUEST_ATTEMPTS; attempt++) {
+        token = GG_BUF(token_mem);
+        *cert_pem_out = cert_pem_mem;
+        ret = send_csr_request(
+            csr_as_ggl_buffer, &token, iotcored, cert_pem_out
+        );
+        if (ret == GG_ERR_OK) {
+            break;
+        }
+        if (attempt < CSR_REQUEST_ATTEMPTS) {
+            GG_LOGW(
+                "Certificate request failed (attempt %d of %d), retrying.",
+                attempt,
+                CSR_REQUEST_ATTEMPTS
+            );
+            (void) gg_sleep(CSR_REQUEST_RETRY_S);
+        }
+    }
     if (ret != GG_ERR_OK) {
         return ret;
     }
