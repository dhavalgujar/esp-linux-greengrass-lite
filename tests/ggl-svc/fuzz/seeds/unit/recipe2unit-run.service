[Unit]
StartLimitInterval=3600
StartLimitBurst=3
Description=ESP32-S31 demo: IPC configuration, local pub/sub and an AWS IoT Core round trip, then a periodic heartbeat to esp32s31/<thing>/heartbeat.
PartOf=greengrass-lite.target
Wants=ggl.core.ggipcd.service
After=ggl.core.ggipcd.service

[Service]
Restart=on-failure
RestartSec=1
WorkingDirectory=/var/lib/greengrass/work/com.espressif.esp32s31.Hello
Environment="AWS_GG_NUCLEUS_DOMAIN_SOCKET_FILEPATH_FOR_COMPONENT=/var/lib/greengrass/gg-ipc.socket"
Type=exec
ExecStart=/usr/bin/recipe-runner -n com.espressif.esp32s31.Hello -v 1.0.0 -p run
SyslogIdentifier=com.espressif.esp32s31.Hello
TimeoutSec=120
User=gg_component
Group=gg_component

[Install]
WantedBy=greengrass-lite.target
