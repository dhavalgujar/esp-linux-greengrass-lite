[Unit]
Description=Greengrass fleet status daemon
StartLimitInterval=20
StartLimitBurst=10
After=ggl.core.ggconfigd.service ggl.core.iotcored.service ggl.core.gghealthd.service

[Service]
Type=exec
User=ggcore
Group=ggcore
ExecStart=/usr/bin/gg-fleet-statusd
WorkingDirectory=/var/lib/greengrass
Restart=always
RestartSec=1
X-GGL-ReadySocket=/run/greengrass/gg_fleet_status
