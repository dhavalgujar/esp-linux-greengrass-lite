[Unit]
Description=Greengrass deployment daemon
StartLimitInterval=20
StartLimitBurst=10
After=ggl.core.ggconfigd.service ggl.core.iotcored.service ggl.core.gghealthd.service ggl.core.tesd.service

[Service]
Type=exec
User=root
Group=ggcore
ExecStart=/usr/bin/ggdeploymentd
WorkingDirectory=/var/lib/greengrass
Restart=always
RestartSec=1
X-GGL-ReadySocket=/run/greengrass/gg_deployment
