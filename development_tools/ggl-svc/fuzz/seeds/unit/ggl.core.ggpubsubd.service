[Unit]
Description=core-bus pub/sub daemon
StartLimitInterval=20
StartLimitBurst=10
After=ggl.core.ggconfigd.service

[Service]
Type=exec
User=ggcore
Group=ggcore
ExecStart=/usr/bin/ggpubsubd
WorkingDirectory=/var/lib/greengrass
Restart=always
RestartSec=1
X-GGL-ReadySocket=/run/greengrass/gg_pubsub
