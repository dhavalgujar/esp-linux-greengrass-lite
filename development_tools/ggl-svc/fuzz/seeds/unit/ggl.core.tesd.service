[Unit]
Description=Token exchange service daemon
StartLimitInterval=20
StartLimitBurst=10
After=ggl.core.ggconfigd.service ggl.core.iotcored.service

[Service]
Type=exec
User=ggcore
Group=ggcore
ExecStart=/usr/bin/tesd
WorkingDirectory=/var/lib/greengrass
Restart=always
RestartSec=1
X-GGL-ReadySocket=/run/greengrass/aws_iot_tes
