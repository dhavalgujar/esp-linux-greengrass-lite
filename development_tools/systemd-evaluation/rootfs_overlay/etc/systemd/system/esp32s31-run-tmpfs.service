[Unit]
Description=Raise the /run tmpfs cap for Greengrass unit reloads
# systemd refuses daemon-reload with less than 16 MiB free under /run.
DefaultDependencies=no
After=local-fs.target
Before=ggl.core.ggdeploymentd.service greengrass-lite.target

[Service]
Type=oneshot
ExecStart=/bin/mount -o remount,size=32M /run
RemainAfterExit=yes

[Install]
WantedBy=greengrass-lite.target
