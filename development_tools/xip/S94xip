# XIP experiment, installed as /etc/init.d/S94xip on the board's root: before
# Greengrass starts, mount the cramfs images on the flash's MTD windows and
# bind their files over the root file system's, so that their program code
# runs in place from flash instead of from page cache copies.
case "$1" in
start)
	for m in rootfs xip2 xip3; do
		grep -q "\"$m\"" /proc/mtd || continue
		d=/xip-$m
		mkdir -p $d
		if mount -t cramfs -o ro mtd:$m $d; then
			for f in $(cd $d && find . -type f | sed 's|^\./||'); do
				mount --bind "$d/$f" "/$f" && echo "xip: /$f"
			done | logger -t xip
		else
			logger -t xip "cannot mount mtd:$m"
		fi
	done
	;;
esac
